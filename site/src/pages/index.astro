---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import BentoTile from '../components/BentoTile.astro';
import PipelineInspector from '../components/PipelineInspector.astro';
import { resolvePath } from '../utils/paths.js';
---

<MarketingLayout
  title="JobFoundry — Your Private, Free AI Job Search Copilot"
  description="Capture jobs from 70+ boards as you browse. Get instant fit scores. Generate truthful, tailored resumes. 100% on your machine — no subscriptions, no cloud, no hallucinations."
  currentPath={resolvePath('/')}
>
  <!-- Metro-Bento Hero Section -->
  <section class="hero-section">
    <div class="site-container">
      <div class="bento-grid">
        <!-- Main Typographic Hero Tile -->
        <BentoTile colSpan={3} variant="accent" class="hero-main-tile">
          <div class="tile-content">
            <div class="tile-badge-row">
              <span class="site-badge cyan">FREE & FREE FOREVER</span>
              <span class="site-badge emerald">AGPL-3.0 FREE & FREE FOREVER</span>
            </div>
            <h1 class="hero-headline">
              YOUR PRIVATE, FREE AI JOB SEARCH COPILOT
            </h1>
            <p class="hero-subtext">
              Browse any job board like you always do — JobFoundry captures listings automatically, collapses duplicate cross-postings, scores your fit with local AI, and generates truthful tailored resumes. No subscriptions. No cloud. No hallucinated experience. Everything runs on your machine.
            </p>
          </div>

          <div class="hero-cta-group">
            <a href={resolvePath('/docs/getting-started/')} class="btn btn-primary">
              Quickstart Guide →
            </a>
            <a href={resolvePath('/docs/extension/')} class="btn btn-secondary">
              Browser Extension (.ZIP)
            </a>
            <a href={resolvePath('/docs/architecture/')} class="btn btn-ghost">
              Pipeline Architecture
            </a>
          </div>
        </BentoTile>

        <!-- Invariant Guarantee Tile -->
        <BentoTile colSpan={1} variant="elevated" class="invariant-tile">
          <div class="tile-top">
            <span class="site-badge amber">STRICT INVARIANT</span>
            <h3 class="tile-title">No Server Scraping. Ever.</h3>
            <p class="tile-desc">
              JobFoundry’s server <strong>never</strong> reaches out to job boards. All capture happens in your browser extension — through your authenticated session, not a datacenter IP that gets blocked.
            </p>
          </div>
          <div class="tile-footer">
            <span class="tile-status-pill">
              <span class="dot emerald"></span>
              Client-Originating
            </span>
          </div>
        </BentoTile>

        <!-- Metric Tile: 87 Providers -->
        <BentoTile colSpan={1} class="metric-tile">
          <div>
            <span class="site-badge cyan">COVERAGE</span>
            <div class="metric-number">70+</div>
            <h4 class="metric-title">Supported Providers</h4>
            <p class="metric-desc">
              Greenhouse, Lever, Ashby, Workday, LinkedIn, Indeed, Dice, and dozens of niche and remote boards.
            </p>
          </div>
          <a href={resolvePath('/docs/providers/')} class="tile-action-link">
            Browse Directory →
          </a>
        </BentoTile>

        <!-- Metric Tile: SimHash Dedup -->
        <BentoTile colSpan={1} class="metric-tile">
          <div>
            <span class="site-badge violet">DEDUPLICATION</span>
            <div class="metric-number">0 Noise</div>
            <h4 class="metric-title">Auto-Dedup</h4>
            <p class="metric-desc">
              The same job cross-posted on 5 boards? You see it once. Duplicate detection runs automatically.
            </p>
          </div>
          <a href={resolvePath('/docs/architecture/')} class="tile-action-link">
            Architecture Details →
          </a>
        </BentoTile>

        <!-- Metric Tile: LLM Fit Scorer -->
        <BentoTile colSpan={1} class="metric-tile">
          <div>
            <span class="site-badge emerald">SCORING ENGINE</span>
            <div class="metric-number">0–100</div>
            <h4 class="metric-title">Local LLM Fit Scoring</h4>
            <p class="metric-desc">
              Every captured job gets a 0–100 fit score with strengths and gap analysis. Works with Ollama, OpenAI, Anthropic, or OpenRouter.
            </p>
          </div>
          <a href={resolvePath('/docs/getting-started/')} class="tile-action-link">
            Configure LLMs →
          </a>
        </BentoTile>

        <!-- Metric Tile: ATS Tailoring -->
        <BentoTile colSpan={1} class="metric-tile">
          <div>
            <span class="site-badge amber">OUTPUT</span>
            <div class="metric-number">PDF</div>
            <h4 class="metric-title">ATS Resume Export</h4>
            <p class="metric-desc">
              Outputs a polished PDF resume and ATS-ready plaintext — your real experience, re-ranked and rephrased, never invented.
            </p>
          </div>
          <a href={resolvePath('/docs/architecture/')} class="tile-action-link">
            Tailoring Details →
          </a>
        </BentoTile>

        <!-- Distribution Quickstart Bar -->
        <BentoTile colSpan={4} class="quickstart-bar-tile">
          <div class="quickstart-inner">
            <div class="quickstart-meta">
              <span class="site-badge cyan">DEFAULT INSTALL</span>
              <h3 class="quickstart-title">Get Running in One Command</h3>
              <p class="quickstart-text">
                Docker or Podman is the recommended way to run JobFoundry. One command auto-detects your runtime, sets up your config, and launches the full stack. A standalone Linux AppImage is also available if you prefer no containers.
              </p>
            </div>
            <div class="quickstart-options">
              <div class="quickstart-option quickstart-command">
                <strong>Docker / Podman (Default)</strong>
                <code>curl -fsSL https://raw.githubusercontent.com/Covai-Labs/JobFoundry/main/install.sh | bash</code>
              </div>
              <a href="https://github.com/Covai-Labs/JobFoundry/releases" target="_blank" rel="noopener noreferrer" class="quickstart-option">
                <strong>Linux AppImage</strong>
                <span>Portable binary, no containers needed</span>
              </a>
              <a href="https://github.com/Covai-Labs/JobFoundry/releases" target="_blank" rel="noopener noreferrer" class="quickstart-option">
                <strong>Windows MSIX</strong>
                <span>Sideload package with Start menu launch</span>
              </a>
            </div>
          </div>
          <a href={resolvePath('/docs/getting-started/')} class="quickstart-guide-link">
            See installation instructions →
          </a>
        </BentoTile>
      </div>
    </div>
  </section>

  <!-- Interactive 5-Stage Pipeline Section -->
  <section class="pipeline-section">
    <div class="site-container">
      <div class="section-header">
        <span class="site-badge cyan">HOW IT WORKS</span>
        <h2 class="section-title">From Browse to Application in 5 Steps</h2>
        <p class="section-desc">
          Browse any job board normally. JobFoundry handles the rest — capturing, deduping, scoring, and tailoring — so you spend your energy on interviews, not spreadsheets.
        </p>
      </div>

      <PipelineInspector />
    </div>
  </section>

  <!-- Architectural Principles Bento Section -->
  <section class="principles-section">
    <div class="site-container">
      <div class="section-header">
        <span class="site-badge violet">WHAT MAKES IT DIFFERENT</span>
        <h2 class="section-title">Built for Real People in a Real Job Search</h2>
        <p class="section-desc">
          No subscriptions. No tracking. No hallucinated resume claims. Just honest, private tooling for the hardest part of anyone’s professional life.
        </p>
      </div>

      <div class="bento-grid">
        <BentoTile colSpan={2} variant="elevated">
          <span class="site-badge emerald">YOUR DATA, YOUR MACHINE</span>
          <h3 class="principle-title">Nothing Leaves Your Computer</h3>
          <p class="principle-desc">
            Your resume, applications, fit scores, and tailored variants are stored locally in SQLite. Zero telemetry. Zero tracking. When using local models via Ollama, zero data leaves your machine; with cloud LLMs, only prompts needed for scoring are sent to your chosen provider.
          </p>
        </BentoTile>

        <BentoTile colSpan={2} variant="elevated">
          <span class="site-badge cyan">GETS PAST THE WALLS</span>
          <h3 class="principle-title">Works Where Server Scrapers Fail</h3>
          <p class="principle-desc">
            Datacenter IPs get blocked by Cloudflare, CAPTCHAs, and login walls every day. Your browser session walks straight through — so JobFoundry captures the listings that scrapers miss.
          </p>
        </BentoTile>

        <BentoTile colSpan={2} variant="elevated">
          <span class="site-badge violet">ZERO HALLUCINATIONS</span>
          <h3 class="principle-title">Your Real Experience, Honestly Presented</h3>
          <p class="principle-desc">
            Other AI resume tools invent fake employers, skills, and metrics. JobFoundry re-ranks and rephrases your existing experience. Listed skills are matched against your master resume before they appear in the output.
          </p>
        </BentoTile>

        <BentoTile colSpan={2} variant="elevated">
          <span class="site-badge amber">FREE FOREVER</span>
          <h3 class="principle-title">AGPL-3.0 Open Source</h3>
          <p class="principle-desc">
            Inspect every line. Self-host it. Fork it. Leave with your data at any time. Tools for stressful moments in people’s lives must never become traps.
          </p>
        </BentoTile>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .hero-section {
    padding: 3rem 0 4rem;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  .hero-main-tile {
    min-height: 380px;
  }

  .tile-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .hero-headline {
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    min-width: 0;
    width: 100%;
  }

  .hero-subtext {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 90%;
    margin-bottom: 2rem;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .invariant-tile {
    min-height: 380px;
    border-top: 3px solid var(--accent-amber);
  }

  .tile-title {
    font-size: 1.35rem;
    margin: 1rem 0 0.75rem;
  }

  .tile-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  .tile-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tile-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-emerald);
    background: var(--accent-emerald-bg);
    border: 1px solid var(--accent-emerald);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot.emerald {
    background-color: var(--accent-emerald);
  }

  .metric-tile {
    min-height: 220px;
  }

  .metric-number {
    font-family: var(--font-heading);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text-primary);
    margin: 0.75rem 0 0.35rem;
    letter-spacing: -0.03em;
  }

  .metric-title {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .metric-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .tile-action-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
  }

  .tile-action-link:hover {
    text-decoration: underline;
  }

  .quickstart-bar-tile {
    background-color: var(--bg-surface-elevated);
  }

  .quickstart-inner {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2rem;
    align-items: center;
    min-width: 0;
    max-width: 100%;
  }

  .quickstart-meta {
    min-width: 0;
  }

  .quickstart-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    min-width: 0;
  }

  .quickstart-option {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    min-width: 0;
    min-height: 82px;
    padding: 0.85rem;
    color: var(--text-primary);
    text-decoration: none;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    background: var(--bg-surface);
    border-radius: var(--radius-xs);
  }

  .quickstart-option:hover {
    border-color: var(--accent-cyan);
    background: var(--bg-surface-hover);
  }

  .quickstart-option strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .quickstart-option span {
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .quickstart-option code {
    display: block;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .quickstart-guide-link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
  }

  .quickstart-guide-link:hover {
    text-decoration: underline;
  }

  .quickstart-title {
    font-size: 1.5rem;
    margin: 0.75rem 0 0.5rem;
    word-break: break-word;
  }

  .quickstart-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  .pipeline-section, .principles-section {
    padding: 4rem 0;
  }

  .section-header {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    margin: 0.75rem 0 0.5rem;
    letter-spacing: -0.02em;
    word-break: break-word;
  }

  .section-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 0;
  }

  .principle-title {
    font-size: 1.25rem;
    margin: 1rem 0 0.5rem;
  }

  .principle-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-main-tile {
      grid-column: span 2;
    }

    .invariant-tile {
      grid-column: span 2;
      min-height: auto;
    }

    .quickstart-bar-tile {
      grid-column: span 2;
    }

    .quickstart-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .quickstart-options {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 1.5rem 0 2.5rem;
    }

    .bento-grid {
      grid-template-columns: 1fr;
    }

    .hero-main-tile, .invariant-tile, .metric-tile, .quickstart-bar-tile {
      grid-column: span 1;
    }

    .hero-main-tile {
      min-height: auto;
    }

    .hero-headline {
      font-size: clamp(1.35rem, 6vw, 1.85rem);
      line-height: 1.2;
    }

    .hero-subtext {
      font-size: 0.95rem;
      max-width: 100%;
      margin-bottom: 1.5rem;
    }

    .hero-cta-group {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 0.6rem;
    }

    .hero-cta-group .btn {
      width: 100%;
      justify-content: center;
    }

    .pipeline-section, .principles-section {
      padding: 2.5rem 0;
    }

    .section-title {
      font-size: 1.65rem;
    }

    .quickstart-title {
      font-size: 1.25rem;
    }
  }
</style>
