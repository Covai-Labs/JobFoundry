---
import BackgroundGrid from '../components/BackgroundGrid.astro';
import ThemeScript from '../components/ThemeScript.astro';
import '../styles/global.css';
import { resolvePath } from '../utils/paths.js';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Featured On & Directory Listings — JobFoundry</title>
    <!-- Prevent search engines from indexing or following links on this page -->
    <meta name="robots" content="noindex, nofollow" />

    <link rel="icon" href={resolvePath('/icons/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={resolvePath('/icons/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={resolvePath('/icons/favicon-16x16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={resolvePath('/icons/apple-touch-icon.png')} />

    <!-- Google Fonts: Outfit, Inter, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <ThemeScript />
  </head>
  <body>
    <BackgroundGrid />

    <main class="featured-page">
      <div class="featured-container">
        <!-- Brand Header (Non-linking, purely visual identity) -->
        <header class="brand-bar">
          <div class="brand-left">
            <img
              src={resolvePath('/icons/icon-32.png')}
              alt="JobFoundry"
              width="28"
              height="28"
              class="brand-icon"
            />
            <div class="brand-info">
              <span class="brand-name">JobFoundry</span>
              <span class="brand-desc">Directory Verifications & Badges</span>
            </div>
          </div>
          <span class="site-badge cyan">Verified Listings</span>
        </header>

        <!-- Main Card Container -->
        <div class="featured-card">
          <div class="card-header">
            <h1 class="card-title">External Listings & Directory Badges</h1>
            <p class="card-subtitle">
              Verified backlinks and directory listings for external startup registries, developer tool catalogs, and platform aggregators.
            </p>
          </div>

          <div class="listings-grid">
            <!-- Launchpadly Listing -->
            <article class="listing-item">
              <div class="item-header">
                <div class="item-title-group">
                  <span class="platform-title">Launchpadly</span>
                  <span class="platform-tag">Startup Directory</span>
                </div>
                <span class="status-indicator">Active Listing</span>
              </div>

              <div class="badge-display">
                <!-- Launchpadly — JobFoundry (text) -->
                <a
                  href="https://launchpadly.co/startup/jobfoundry?ref=badge"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-launchpadly-badge="jobfoundry"
                  class="badge-link"
                >
                  Proudly listed on Launchpadly Startup Directory
                </a>
              </div>
            </article>

            <!-- More badges can be added here following the same structure -->
          </div>
        </div>

        <footer class="featured-footer">
          <span>JobFoundry &bull; Local-First AI Job Search & Resume Tailoring</span>
        </footer>
      </div>
    </main>
  </body>
</html>

<style>
  .featured-page {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justifyContent: center;
    align-items: center;
    padding: 3rem 1.5rem;
  }

  .featured-container {
    width: 100%;
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
  }

  .brand-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-icon {
    border-radius: var(--radius-xs);
    display: block;
  }

  .brand-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .brand-desc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .featured-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .card-header {
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .card-subtitle {
    font-size: 0.925rem;
    color: var(--text-secondary);
    margin-bottom: 0;
    line-height: 1.5;
  }

  .listings-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .listing-item {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.15s ease;
  }

  .listing-item:hover {
    border-color: var(--border-strong);
  }

  .item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .item-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .platform-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .platform-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .status-indicator {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-emerald);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .status-indicator::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-emerald);
  }

  .badge-display {
    padding: 0.85rem 1rem;
    background: var(--bg-surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
  }

  .badge-link {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent-cyan);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .badge-link:hover {
    text-decoration: underline;
    color: var(--accent-cyan);
  }

  .featured-footer {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.5rem;
  }

  @media (max-width: 640px) {
    .featured-page {
      padding: 1.5rem 1rem;
    }

    .featured-card {
      padding: 1.25rem;
    }

    .brand-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
  }
</style>
